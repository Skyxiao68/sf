    - target: {fileID: 4030292186588115507, guid: db6b3c2b2d919084fb00fca60ea6fc9e, type: 3}
      propertyPath: 'story.fullStory.Array.data[0]'
      value: "\u201CYou have pieced together the story of a forgotten keeper:\r\nLong
        ago, a guardian built this maze to protect a gift.\r\nThe gift was split
        into five tokens, each hidden in a branch, so that only the determined could
        reclaim it.\r\nThe fragments you found were his memories\u2014warnings, hopes,
        and finally a promise:\r\n\u2018The maze does not trap the lost; it waits
        for those ready to find their way.\u2019\r\nNow the exit shines, and you
        step out with the truth.\u201D"
      objectReference: {fileID: 0}
